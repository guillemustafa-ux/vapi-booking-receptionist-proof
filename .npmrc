# better-sqlite3 13 ships prebuilt binaries and declares "gypfile": false, yet npm 10
# (bundled with Node 22) still runs `node-gyp rebuild` for it, which fails wherever
# node-gyp finds no usable Visual Studio (the windows-latest runner on 2026-11-07).
# The other install scripts skipped (esbuild, the optional fsevents) are not needed here:
# esbuild ships its platform binary as an optional dependency.
ignore-scripts=true
